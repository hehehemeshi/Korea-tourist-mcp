SEOUL_API_KEY=
SEOUL_SUBWAY_API_KEY=
DATA_GO_KR_KEY=
ACCESS_TOKEN=
# NETWORK_FILE=/app/network.json
KTO_API_KEY=
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# For ChatGPT only if choosing No authentication:
# MCP_PUBLIC=false
# OpenStreetMap discovery by default; false selects keyed providers when configured.
OPEN_DATA_FIRST=true

# Optional walking routes; no straight-line multiplier if absent.
ORS_API_KEY=
# Optional override for reviewed restaurant evidence JSON. Packaged registry is empty.
# RESTAURANT_EVIDENCE_FILE=/app/restaurant_evidence.json
# Optional override; default bundled catalog has 5 public source profiles.
# RESTAURANT_SOURCE_CATALOG=/app/restaurant_sources.json

# Optional web companion at /. Keep all secret keys on Render, never in browser chat.
# Route planning requires Routes API enabled and billing/quota configured.
GOOGLE_ROUTES_API_KEY=
# Publishable Maps JavaScript key: restrict HTTP referrers to your service URL and API to Maps JS.
GOOGLE_MAPS_BROWSER_KEY=
# Separate OpenAI API account/key; ChatGPT subscription does not supply an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
